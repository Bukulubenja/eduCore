# Copy to .env and adjust. Never commit .env.

DEBUG=True
SECRET_KEY=change-me-locally
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Omit entirely to fall back to SQLite. Doing so skips the row-level security
# tests -- see the warning pytest prints when it does.
DATABASE_URL=postgres://educore:educore@localhost:5432/educore

REDIS_URL=redis://localhost:6379/0

# Production only
# PGSSLMODE=require
# CSRF_TRUSTED_ORIGINS=https://app.educore.example
# SENTRY_DSN=
# RELEASE_TAG=
